// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario{
  id      Int       @id @default(autoincrement())
  nome    String    @db.VarChar(80)
  email   String    @unique @db.VarChar(100)
  hash    String

  leitores Leitor[]
  bibliotecarios Bibliotecario[]
}

model Leitor{
  id   Int   @id @default(autoincrement())
  id_usuario  Int
  usuario   Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  cpf  String   @db.VarChar(14)   @unique   
  telefone  String?    @db.VarChar(11)

  cep          String?  @db.VarChar(8)
  logradouro   String?  @db.VarChar(150)
  numero       String?  @db.VarChar(20)
  complemento  String?  @db.VarChar(80)
  bairro       String?  @db.VarChar(80)
  cidade       String?  @db.VarChar(80)
  uf           String?  @db.Char(2)

  suspensoes   Suspensao[]
  leitorClubes LeitorClube[]
  emprestimos Emprestimo[]
  comentarios Comentario[]
  reservas Reserva[]
}

model Bibliotecario{
  id   Int   @id @default(autoincrement())
  id_usuario  Int
  usuario   Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  suspensoesAplicadas Suspensao[]
}

// Bloqueio temporário (dataFim) ou indefinido (dataFim nula) de um leitor.
// Encerrada antes do prazo quando dataEncerramento é preenchida.
model Suspensao {
  id               Int       @id @default(autoincrement())
  id_leitor        Int
  leitor           Leitor    @relation(fields: [id_leitor], references: [id], onDelete: Cascade)
  motivo           String    @db.VarChar(500)
  dataInicio       DateTime  @default(now())
  dataFim          DateTime?
  dataEncerramento DateTime?
  id_bibliotecario Int?
  bibliotecario    Bibliotecario? @relation(fields: [id_bibliotecario], references: [id], onDelete: SetNull)

  @@index([id_leitor])
}

model Obra {
  id              Int       @id @default(autoincrement())
  isbn            String?   @unique @db.VarChar(20)
  titulo          String    @db.VarChar(200)
  subtitulo       String?   @db.VarChar(200)
  editora         String?   @db.VarChar(100)
  localPublicacao String?   @db.VarChar(100)
  anoPublicacao   Int?
  edicao          String?   @db.VarChar(20)
  numeroPaginas   Int       @default(0)
  resumo          String?   @db.Text
  capa            String?   @db.VarChar(20)
  capaUrl         String?   @db.VarChar(500)
  ativa           Boolean   @default(true)
  notaMedia       Float?

  id_cdd          String?   @db.VarChar(15)
  cdd             Cdd?      @relation(fields: [id_cdd], references: [id], onUpdate: Cascade, onDelete: SetNull)

  exemplares      Exemplar[]
  reservas        Reserva[]
  comentarios     Comentario[]
  autores         ObraAutor[]

  @@index([titulo])
  @@index([isbn])
}

model ObraAutor{
  id_obra    Int
  obra    Obra    @relation(fields: [id_obra], references: [id], onDelete: Cascade)
  id_autor   Int
  autor   Autor   @relation(fields: [id_autor], references: [id], onDelete: Cascade)

  @@id([id_obra, id_autor])
}

model Autor {
  id        Int         @id @default(autoincrement())
  nome      String      @db.VarChar(80)
  sobrenome String      @db.VarChar(80)

  obras     ObraAutor[]

  
  @@unique([nome, sobrenome], name: "nome_sobrenome")
}

model Cdd {
  id        String   @id @db.VarChar(15)
  descricao String   @db.VarChar(150)

  obras     Obra[]
}

model Clube{
  id    Int   @id @default(autoincrement())
  nome    String    @db.VarChar(40)
  descricao   String?
  dataCriacao   DateTime
  status    String

  leitorClubes LeitorClube[]
}

model LeitorClube{
  id_leitor   Int   
  leitor    Leitor    @relation(fields: [id_leitor], references: [id], onDelete: Cascade)
  id_clube    Int
  clube   Clube   @relation(fields: [id_clube], references: [id], onDelete: Cascade)

  @@id([id_leitor, id_clube])
}

model Exemplar {
  id               Int          @id @default(autoincrement())
  id_obra          Int
  obra             Obra         @relation(fields: [id_obra], references: [id], onDelete: Cascade)
  numeroInventario String       @unique @db.VarChar(20)
  disponivel       Boolean      @default(true)

  emprestimos      Emprestimo[]

  @@index([id_obra, disponivel])
}

model Emprestimo{
  id    Int     @id @default(autoincrement())
  dataInicio    DateTime    @default(now())
  diasLocacao   Int
  statusDevolucao   Boolean   @default(false)
  dataDevolucao     DateTime?
  lembreteEnviadoEm DateTime?
  
  id_leitor     Int
  leitor    Leitor    @relation(fields: [id_leitor], references: [id], onDelete: Cascade)

  id_exemplar   Int
  exemplar    Exemplar    @relation(fields: [id_exemplar], references: [id], onDelete: Cascade)

}

model Reserva{
  id    Int   @id @default(autoincrement())
  dataReserva     DateTime
  id_obra    Int
  obra    Obra @relation(fields: [id_obra], references: [id], onDelete: Cascade)
  id_leitor     Int
  leitor    Leitor    @relation(fields: [id_leitor], references: [id], onDelete: Cascade)
}

model Comentario{
  id    Int   @id @default(autoincrement())
  dataPublicacao    DateTime
  texto   String?    @db.VarChar(1000)
  nota    Int?
  curtidas    Int     @default(0)
  moderado    Boolean     @default(false)

  id_obra     Int
  obra    Obra    @relation(fields: [id_obra], references: [id], onDelete: Cascade)
  id_leitor     Int
  leitor    Leitor    @relation(fields: [id_leitor], references: [id], onDelete: Cascade)
}