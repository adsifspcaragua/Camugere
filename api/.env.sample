# Banco MySQL: mysql://USUARIO:SENHA@localhost:3306/camugere
DATABASE_URL="mysql://camugere:troque-esta-senha@localhost:3306/camugere"

# Frase longa e aleatória, só deste computador. Para gerar:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Endereço que a equipe abre no navegador (usado no link de "esqueci minha senha").
APP_URL="http://localhost:3000"
# PORT=3000
# JWT_EXPIRES_IN="24h"
# CORS_ORIGIN="http://localhost:3000"
# API_PUBLIC_URL="http://localhost:3000"

# E-mail (comprovantes, lembretes e "esqueci minha senha"). Sem SMTP, o sistema não envia e-mails.
# No Gmail, SMTP_PASS é uma senha de app: https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="biblioteca@gmail.com"
# SMTP_PASS="senha-de-app"
# SMTP_FROM="Biblioteca Camugerê <biblioteca@gmail.com>"

# Lembrete por e-mail X dias antes do vencimento (verificado de hora em hora)
# LEMBRETE_DIAS_ANTES=2
# LEMBRETES_AUTOMATICOS=true

# Só desenvolvimento: sem SMTP, manda os e-mails para uma caixa de teste do Ethereal.
# EMAIL_TESTE=true
